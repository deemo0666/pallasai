    "替你查、替你记、替你在手机上把事办了" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchiert, merkt sich und erledigt Dinge für dich auf dem iPhone"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks things up, keeps track, and gets things done on your phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca, recuerda y resuelve cosas en tu teléfono por ti"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cherche, retient et fait les choses sur votre téléphone à votre place"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca per te, tiene traccia e sbriga le cose sul tuo telefono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調べて、覚えて、iPhone での用事まで代わりに済ませます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찾고, 기억하고, 휴대폰에서 일을 대신 처리해 줘요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa, anota e resolve as coisas no seu celular por você"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищет, запоминает и выполняет дела на вашем телефоне"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幫你查、幫你記、幫你在手機上把事辦好"
          }
        }
      }
    },
    "替你查、替你记、替你打电话，在手机上把事办了" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchiert, merkt sich, telefoniert und erledigt Dinge für dich auf dem iPhone"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks things up, keeps track, makes calls, and gets things done on your phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca, recuerda, hace llamadas y resuelve cosas en tu teléfono por ti"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cherche, retient, passe des appels et fait les choses sur votre téléphone à votre place"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca per te, tiene traccia, telefona e sbriga le cose sul tuo telefono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調べて、覚えて、電話もかけて、iPhone での用事まで代わりに済ませます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찾고, 기억하고, 전화도 걸고, 휴대폰에서 일을 대신 처리해 줘요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa, anota, faz ligações e resolve as coisas no seu celular por você"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищет, запоминает, звонит и выполняет дела на вашем телефоне"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幫你查、幫你記、幫你打電話，在手機上把事辦好"
          }
        }
      }
    },
