    },
    "自动续签后台项目未运行，请在系统设置中允许此安装器的后台活动后重试。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hintergrundobjekt für die automatische Erneuerung läuft nicht. Erlaube die Hintergrundaktivität dieses Installers in den Systemeinstellungen und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The automatic renewal background item is not running. Allow this installer's background activity in System Settings, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El elemento en segundo plano de la renovación automática no se está ejecutando. Permite la actividad en segundo plano de este instalador en Ajustes del Sistema y vuelve a intentarlo."
