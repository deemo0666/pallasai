          }
        }
      }
    },
    "自动续签已暂停。请使用“全部安装”并开启自动续签以恢复。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Erneuerung ist pausiert. Verwende „Alles installieren“ mit aktivierter automatischer Erneuerung, um sie wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic renewal is paused. Use Install all with automatic renewal enabled to restore it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La renovación automática está en pausa. Usa «Instalar todo» con la renovación automática activada para restaurarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le renouvellement automatique est en pause. Utilisez « Tout installer » avec le renouvellement automatique activé pour le rétablir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rinnovo automatico è in pausa. Usa Installa tutto con il rinnovo automatico attivo per ripristinarlo."
