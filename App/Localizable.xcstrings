          "stringUnit" : {
            "state" : "translated",
            "value" : "El ordenador no aceptó la conexión. Asegúrate de que esté encendido y de que su servicio esté en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur n’a pas accepté la connexion. Vérifiez qu’il est allumé et que son service est en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer non ha accettato la connessione. Assicurati che sia acceso e che il suo servizio sia in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータが接続を受け付けませんでした。コンピュータの電源が入っていて、サービスが動作していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터가 연결을 수락하지 않았어요. 컴퓨터가 켜져 있고 컴퓨터의 서비스가 실행 중인지 확인해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O computador não aceitou a conexão. Confirme que ele está ligado e que o serviço está em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компьютер не принял подключение. Убедитесь, что он включён и его служба запущена."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦沒有接受連線。請確認電腦開著，且電腦上的服務正在執行。"
          }
        }
      }
    },
