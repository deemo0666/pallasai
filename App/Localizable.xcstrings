    "已退出 Apple 账号，自动续签会等待重新登录。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Apple-Account abgemeldet. Die automatische Erneuerung wartet, bis du dich wieder anmeldest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed out of Apple Account. Automatic renewal will wait until you sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cerrado la sesión de la cuenta de Apple. La renovación automática esperará hasta que vuelvas a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecté du compte Apple. Le renouvellement automatique attendra que vous vous reconnectiez."
