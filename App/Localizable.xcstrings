        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動更新は一時停止中です。「すべてインストール」で自動更新をオンにして再開してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 갱신이 일시 중지되었습니다. \"모두 설치\"를 사용하고 자동 갱신을 켜서 다시 시작해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renovação automática está pausada. Use Instalar tudo com a renovação automática ativada para restaurá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматическое продление приостановлено. Чтобы восстановить его, используйте «Установить всё» с включённым автоматическим продлением."
          }
