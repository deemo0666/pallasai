    "钥匙串未能保存授权，无法开启自动续签。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund konnte die Autorisierung nicht sichern. Die automatische Erneuerung kann nicht aktiviert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain could not save authorization. Automatic renewal cannot be enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llavero no pudo guardar la autorización. No se puede activar la renovación automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Trousseau n’a pas pu enregistrer l’autorisation. Impossible d’activer le renouvellement automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
