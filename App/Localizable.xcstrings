        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión usa datos de verificación del dispositivo de ani.iloader.app. Ese servicio no recibe tu cuenta de Apple, tu contraseña ni tu código de verificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
