    "配对端口被别的程序占用了，请关掉电脑上的 DSH 配对插件。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App belegt die Kopplungsports. Deaktiviere das DSH-Kopplungs-Plugin auf diesem Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app is using the pairing ports. Turn off the DSH pairing plugin on this computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está usando los puertos de emparejamiento. Desactiva el plugin de emparejamiento de DSH en este ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
