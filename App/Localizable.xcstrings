          }
        }
      }
    },
    "自动续签已暂停，请用当前安装器重新安装并开启续签。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatische Erneuerung ist pausiert. Installiere mit dem aktuellen Installer erneut und aktiviere die Erneuerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic renewal is paused. Reinstall with the current installer and enable renewal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La renovación automática está en pausa. Vuelve a instalar con el instalador actual y activa la renovación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le renouvellement automatique est en pause. Réinstallez avec l’installateur actuel et activez le renouvellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rinnovo automatico è in pausa. Reinstalla con il programma di installazione attuale e attiva il rinnovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動更新は一時停止中です。現在のインストーラで再インストールして、更新をオンにしてください。"
          }
