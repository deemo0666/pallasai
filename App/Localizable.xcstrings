          }
        }
      }
    },
    "请用 folders 返回的目录 ID；目录可能未授权、已撤销或同名。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende eine von folders zurückgegebene Ordner-ID; der Ordner ist möglicherweise nicht freigegeben, widerrufen oder namensgleich mit einem anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a folder ID returned by folders; the folder may be unauthorized, revoked, or share its name with another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un ID de carpeta devuelto por folders; la carpeta puede no estar autorizada, haberse revocado o compartir nombre con otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un ID de dossier renvoyé par folders ; le dossier est peut-être non autorisé, révoqué ou homonyme d’un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un ID cartella restituito da folders; la cartella potrebbe non essere autorizzata, essere stata revocata o avere lo stesso nome di un'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "folders が返したフォルダ ID を使用してください。フォルダが未許可、取り消し済み、または同名の可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "folders가 반환한 디렉터리 ID를 사용해 주세요. 디렉터리에 권한이 없거나 취소되었거나 이름이 같을 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um ID de pasta retornado por folders; a pasta pode não estar autorizada, ter sido revogada ou ter o mesmo nome de outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте ID папки, возвращённый folders; папка может быть не разрешена, отозвана или иметь то же имя, что и другая."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用 folders 回傳的目錄 ID；該目錄可能未授權、已撤銷或同名。"
          }
        }
      }
    },
    "请确认电脑开着，手机和电脑连着同一个 Wi-Fi，电脑的防火墙没有拦住它。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass der Computer eingeschaltet ist, iPhone und Computer im selben WLAN sind und die Firewall des Computers die Verbindung nicht blockiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the computer is on, your phone and computer are on the same Wi-Fi, and the computer's firewall isn't blocking it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que el ordenador esté encendido, de que el teléfono y el ordenador estén en el mismo Wi-Fi y de que el cortafuegos del ordenador no lo bloquee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que l’ordinateur est allumé, que votre téléphone et l’ordinateur sont sur le même Wi-Fi et que le pare-feu de l’ordinateur ne le bloque pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che il computer sia acceso, che telefono e computer siano sullo stesso Wi-Fi e che il firewall del computer non lo blocchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータの電源が入っていること、iPhone とコンピュータが同じ Wi-Fi に接続されていること、コンピュータのファイアウォールがブロックしていないことを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터가 켜져 있는지, 휴대폰과 컴퓨터가 같은 Wi-Fi에 연결되어 있는지, 컴퓨터 방화벽이 막고 있지 않은지 확인해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme que o computador está ligado, que o celular e o computador estão no mesmo Wi‑Fi e que o firewall do computador não está bloqueando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что компьютер включён, телефон и компьютер в одной сети Wi‑Fi, а брандмауэр компьютера её не блокирует."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認電腦開著，手機和電腦連著同一個 Wi-Fi，且電腦的防火牆沒有擋住它。"
          }
        }
      }
    },
