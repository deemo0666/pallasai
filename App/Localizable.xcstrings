          }
        }
      },
      "shouldTranslate" : false
    },
    "\n\n主机上找到了 %@，可以由手机通过 SSH 启动（运行 dsh web，只监听主机本地）。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ auf dem Host gefunden. Das iPhone kann es per SSH starten (führt dsh web aus, hört nur lokal auf dem Host zu)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nFound %@ on the host. The phone can start it over SSH (runs dsh web, listening only on the host locally)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nSe encontró %@ en el host. El teléfono puede iniciarlo por SSH (ejecuta dsh web, solo escucha en local en el host)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ trouvé sur l’hôte. Le téléphone peut le lancer via SSH (exécute dsh web, à l’écoute uniquement en local sur l’hôte)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTrovato %@ sull'host. Il telefono può avviarlo tramite SSH (esegue dsh web, in ascolto solo in locale sull'host)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nホストで %@ が見つかりました。iPhone から SSH 経由で起動できます（dsh web を実行し、ホスト上のローカルのみで待ち受けます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n호스트에서 %@을(를) 찾았어요. 휴대폰이 SSH로 시작할 수 있어요(dsh web을 실행하며, 호스트 로컬에서만 수신해요)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n%@ encontrado no host. O celular pode iniciá-lo por SSH (executa dsh web, escutando apenas localmente no host)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nНа хосте найден %@, его можно запустить с телефона по SSH (запускается dsh web, слушает только локально на хосте)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n在主機上找到了 %@，可以由手機透過 SSH 啟動（執行 dsh web，只監聽主機本機）。"
          }
        }
      }
    },
    "\n\n可以由手机通过 SSH 运行 dsh web（只监听主机本地）。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nDas iPhone kann dsh web per SSH ausführen (hört nur lokal auf dem Host zu)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nThe phone can run dsh web over SSH (listening only on the host locally)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nEl teléfono puede ejecutar dsh web por SSH (solo escucha en local en el host)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nLe téléphone peut exécuter dsh web via SSH (à l’écoute uniquement en local sur l’hôte)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nIl telefono può eseguire dsh web tramite SSH (in ascolto solo in locale sull'host)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\niPhone から SSH 経由で dsh web を実行できます（ホスト上のローカルのみで待ち受けます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n휴대폰이 SSH로 dsh web을 실행할 수 있어요(호스트 로컬에서만 수신해요)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nO celular pode executar dsh web por SSH (escutando apenas localmente no host)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nС телефона можно запустить dsh web по SSH (слушает только локально на хосте)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n可以由手機透過 SSH 執行 dsh web（只監聽主機本機）。"
          }
        }
      }
    },
    "\n\n注意：这个恢复点来自「%@」。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nHinweis: Dieser Wiederherstellungspunkt stammt von „%@“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNote: this restore point is from “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNota: este punto de restauración procede de «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nRemarque : ce point de restauration provient de « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNota: questo punto di ripristino proviene da “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n注意：この復元ポイントは「%@」のものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n참고: 이 복원 지점은 “%@”에서 만들어졌어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nAtenção: este ponto de restauração vem de “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nВнимание: эта точка восстановления создана в «%@»."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n注意：這個還原點來自「%@」。"
          }
        }
      }
    },
    "\n再点一次保存只会重试 API Key。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nEin erneutes Tippen auf Sichern wiederholt nur den API-Schlüssel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTapping Save again will only retry the API Key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nSi vuelves a tocar Guardar, solo se reintentará la API Key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUn nouvel appui sur Enregistrer ne réessaiera que l’API Key."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nToccando di nuovo Salva verrà riprovata solo la chiave API."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nもう一度「保存」をタップすると、API Key のみ再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n저장을 다시 누르면 API Key만 다시 시도해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTocar em Salvar de novo só tentará a chave de API outra vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nПовторное нажатие «Сохранить» повторит только API-ключ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n再按一次儲存只會重試 API Key。"
          }
        }
      }
    },
