    "iPhone 未能启用手机控制运行环境，请保持解锁和联网后重试。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPhone konnte die Laufzeitumgebung für die Telefonsteuerung nicht aktivieren. Lass es entsperrt und online und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPhone could not enable the phone control runtime. Keep it unlocked and online, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone no pudo activar el entorno de control del teléfono. Mantenlo desbloqueado y con conexión, y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPhone n’a pas pu activer l’environnement de contrôle du téléphone. Gardez-le déverrouillé et connecté, puis réessayez."
