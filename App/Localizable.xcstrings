        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". 플러그인 코드는 이 기기 엔진의 권한으로 실행돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". O código do plug-in será executado com as permissões do mecanismo deste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Код плагина будет выполняться с правами движка на этом устройстве."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。外掛程式碼將以本機引擎的權限執行。"
          }
        }
      }
    },
    "。插件会在本机运行，并拥有 Pallas Agent 的权限。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Das Plugin wird auf diesem Gerät mit denselben Berechtigungen wie Pallas Agent ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". The plugin runs on this device with the same permissions as Pallas Agent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". El complemento se ejecutará en este dispositivo con los mismos permisos que Pallas Agent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". Le module s’exécutera sur cet appareil avec les mêmes autorisations que Pallas Agent."
