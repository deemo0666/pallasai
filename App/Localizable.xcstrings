        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 계정에서 로그아웃했습니다. 다시 로그인할 때까지 자동 갱신은 대기합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
