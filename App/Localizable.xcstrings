    "本机没有在运行。到设置的「高级」里打开「本机运行」。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone läuft nicht. Schalte unter Einstellungen › Erweitert „Auf diesem Gerät ausführen“ ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone isn't running. Turn on Run on This Device in Settings › Advanced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no está en ejecución. Activa «Ejecutar en este dispositivo» en Ajustes › Avanzado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone n’est pas en cours d’exécution. Activez « Exécuter sur cet appareil » dans Réglages › Avancé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non è in esecuzione. Attiva “Esegui su questo dispositivo” in Impostazioni › Avanzate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone では実行されていません。設定の「詳細」で「このデバイスで実行」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 실행 중이 아니에요. 설정의 “고급”에서 “이 기기에서 실행”을 켜 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone não está em execução. Ative “Executar neste aparelho” em Ajustes › Avançado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
