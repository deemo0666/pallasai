          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the host is on, the address and port are correct, and SSH is turned on for the host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que el host esté encendido, de que la dirección y el puerto sean correctos y de que SSH esté activado en el host."
