            "value" : "請回到 Pallas Agent 使用手機控制。本次只安裝了元件，不計為兩個 App 的續簽。"
          }
        }
      }
    },
    "请回到 iPhone 的 Pallas Agent 重试手机控制；是否可用以实际操作结果为准。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre zu Pallas Agent auf deinem iPhone zurück und versuche die Telefonsteuerung erneut. Ob sie funktioniert, zeigt erst der tatsächliche Vorgang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Return to Pallas Agent on your iPhone and retry phone control. Actual operation determines whether it works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a Pallas Agent en tu iPhone y reintenta el control del teléfono. Que funcione se confirma con el resultado real."
