    "若提示不受信任：设置 → 通用 → VPN 与设备管理 → 开发者 App → 信任。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn iOS einen nicht vertrauenswürdigen Entwickler meldet: Einstellungen → Allgemein → VPN & Geräteverwaltung → Entwickler-App → Vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If iOS reports an untrusted developer: Settings → General → VPN & Device Management → Developer App → Trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si iOS indica que el desarrollador no es de confianza: Ajustes → General → VPN y gestión de dispositivos → App de desarrollador → Confiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si iOS signale un développeur non fiable : Réglages → Général → VPN et gestion de l’appareil → App de développeur → Faire confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se iOS segnala uno sviluppatore non attendibile: Impostazioni → Generali → VPN e gestione dispositivo → App sviluppatore → Autorizza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼されていないと表示された場合：設定 → 一般 → VPNとデバイス管理 → デベロッパApp → 信頼。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 없다고 표시되면: 설정 → 일반 → VPN 및 기기 관리 → 개발자 앱 → 신뢰."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o iOS indicar um desenvolvedor não confiável: Ajustes → Geral → VPN e Gerenciamento de Dispositivo → App de Desenvolvedor → Confiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если iOS сообщает о недоверенном разработчике: Настройки → Основные → VPN и управление устройством → Приложение разработчика → Доверять."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若提示不受信任：設定 → 一般 → VPN 與裝置管理 → 開發者 App → 信任。"
          }
        }
      }
    },
