        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reduce Motion” is on in system settings, so motion stays off"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Reducir movimiento» está activado en los ajustes del sistema, así que el movimiento sigue desactivado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
