        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메인 앱은 설치되었지만 무료 서명 앱 한도가 가득 차서 iPhone 제어 구성요소가 설치되지 않았습니다. 더 이상 필요 없는 이전 사이드로딩 앱을 하나 삭제한 후 다시 설치해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app principal foi instalado, mas o limite de apps com assinatura gratuita impediu a instalação do componente de controle. Remova um app de sideload antigo de que você não precisa e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
