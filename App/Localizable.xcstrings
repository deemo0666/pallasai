        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iPhone não conseguiu ativar o ambiente de execução do controle do telefone. Mantenha-o desbloqueado e online e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone не смог включить среду выполнения для управления телефоном. Оставьте его разблокированным и подключённым к сети, затем повторите попытку."
          }
